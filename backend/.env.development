# Development Environment
NODE_ENV=development

# Database - Using in-memory SQLite for development
DATABASE_URL=file:./dev.db

# JWT Secrets - Development keys (minimum 16 chars)
JWT_ACCESS_SECRET=dev-secret-access-key-minimum-16-chars
JWT_REFRESH_SECRET=dev-secret-refresh-key-minimum-16-chars
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d

# Optional services (can be empty for development)
REDIS_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PUBLIC_URL=
RESEND_API_KEY=
EMAIL_FROM=noreply@peoplepay360.dev
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
